[run]
source = src
omit =
    */tests/*
    */test_*.py
    */__pycache__/*

[report]
exclude_lines =
    # Have to re-enable the standard pragma
    pragma: no cover

    # Don't complain about missing debug-only code
    def __repr__
    def __str__

    # Don't complain if tests don't hit defensive assertion code
    raise AssertionError
    raise NotImplementedError

    # Don't complain if non-runnable code isn't run
    if __name__ == .__main__.:
    if TYPE_CHECKING:

    # Numba JIT-compiled functions - can't be instrumented by coverage tools
    @nb.njit
    @nb\.njit\(\)
    @auxcc\.export
    # def dstate_dt
    # def dCaq_dt\(
    # def dCaq_dt_diffusion_limited
    # def IEPOX_condensation
    # def beta_FS
    # def water_viscosity
    # def dCgas_dt
    # def dCaq_dt\(

    # Decorators from numba packages
    from numba

precision = 2
skip_covered = False
skip_empty = True

[html]
directory = htmlcov
